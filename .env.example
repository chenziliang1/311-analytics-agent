# =============================================================================
# Secrets, and nothing else.
#
#     cp .env.example .env
#
# .env is gitignored -- never commit real credentials, and never let an AI
# assistant open it. Everything a dataset swap changes is elsewhere.
#
# EVERY NON-SECRET SETTING IS IN `.env.defaults`, which is committed. Look there
# for the schema name, the LLM provider and model, the AWS region, the database
# port, and the quota caps.
#
# `.env` is loaded FIRST and wins, so any key from `.env.defaults` can also be
# put here to override it on this machine alone -- pointing one checkout at a
# staging schema, say:
#
#     SCHEMA_NAME="acme_widgets_staging"
#
# Leaving a value as the literal "..." is the same as not setting it. `get_env`
# in agent_app/config.py treats that placeholder as unset, so a half-filled copy
# of this file cannot shadow a working credential chain.
# =============================================================================


# -----------------------------------------------------------------------------
# Provider credentials -- fill in ONLY the one matching LLM_PROVIDER
#
# LLM_PROVIDER itself is in .env.defaults; which provider you talk to is not a
# secret, the key is.
#
# No per-provider install step: all four SDKs are core dependencies in
# pyproject.toml, so a plain `uv sync` locally and Vercel's own build (it reads
# pyproject.toml + uv.lock) both have every one of them. Switching provider is
# one environment variable, never a reinstall or a redeploy config change.
# -----------------------------------------------------------------------------

# --- LLM_PROVIDER="bedrock" ---
# Bedrock authenticates with AWS credentials, not an API key.
#
# LOCAL DEVELOPMENT: leave both of these COMMENTED OUT. boto3 reads environment
# variables BEFORE ~/.aws/credentials, so setting them here -- even to a
# placeholder -- shadows your working local profile, and Bedrock fails with a
# confusing "UnrecognizedClientException: The security token included in the
# request is invalid".
#
# DEPLOYMENT (Vercel): serverless has no ~/.aws, so set both as real environment
# variables in the Vercel dashboard instead of in this file.
#AWS_ACCESS_KEY_ID="..."
#AWS_SECRET_ACCESS_KEY="..."

# --- LLM_PROVIDER="anthropic" --- Claude API key, from console.anthropic.com
#ANTHROPIC_API_KEY="sk-ant-..."

# --- LLM_PROVIDER="openai" --- OpenAI API key, from platform.openai.com  [DEFAULT]
#OPENAI_API_KEY="sk-..."

# --- LLM_PROVIDER="google" --- Gemini API key, from aistudio.google.com
#GOOGLE_API_KEY="..."


# -----------------------------------------------------------------------------
# Database -- for WAREHOUSE="postgres" (Neon)
# -----------------------------------------------------------------------------
# The agent reads the same NeonDB Postgres instance in every environment; there
# is no SQLite fallback on a laptop. That used to be the arrangement, and it
# meant every SQL example in the system prompt was written against SQLite and
# then shipped to Postgres, where `strftime` and `JULIANDAY` do not exist --
# silently, because the agent's SQL tool hands database errors back to the model
# as text. One database everywhere is what keeps a single prompt honest; the
# full story is in `DbMixin.engine`.
#
# The tables must already be loaded into this schema; the app only reads them.
# (On Snowflake, `mise run snowflake-load` loads them; see infra/snowflake/.)
#
# Use the -pooler host: the app pins `search_path` with `SET LOCAL`, which is
# the only form that survives transaction pooling.
#
# Tables live in the schema named by SCHEMA_NAME in .env.defaults, so other
# projects can share this instance untouched. DB_PORT is there too -- it is 5432
# and identifies nothing.
#DB_HOST="...-pooler.c-4.us-east-1.aws.neon.tech"
#DB_USER="neondb_owner"
#DB_PASS="npg_1a2b3c..."
#DB_NAME="neondb"


# -----------------------------------------------------------------------------
# Sign-in -- optional, normally set only on Vercel
# -----------------------------------------------------------------------------
# GitHub sign-in in front of the whole site (lib/auth.ts, proxy.ts). Leave
# AUTH_GITHUB_ID unset and there is no sign-in at all, which is what local
# development wants. From a GitHub OAuth app whose callback URL is
# <site>/auth/callback/github. AUTH_SECRET signs the session cookie: any long
# random string (`openssl rand -base64 32`).
#AUTH_GITHUB_ID="Ov23li..."
#AUTH_GITHUB_SECRET="..."
#AUTH_SECRET="..."
# Not a secret, but it lives with the three above: comma-separated GitHub
# logins allowed to sign in. Empty lets any GitHub account in.
#AUTH_ALLOWED_GITHUB_USERS="octocat,another-login"
