# =============================================================================
# Committed configuration. No secrets, ever.
#
# This file is IN GIT, on purpose. Everything in it is either a fact about the
# dataset (identical in every deployment) or a non-sensitive default that is
# fine to publish. Keeping it committed is what makes a dataset swap reviewable:
# the change shows up in `git diff` like any other.
#
# Loading order: `.env` is read FIRST and wins, then this file fills in whatever
# `.env` did not set. So any line here can be overridden per machine by adding
# the same key to your own `.env` -- see `Config.new_in_local_runtime`.
#
#   .env           secrets + your machine's overrides   (gitignored, never read
#                                                        or edited by an AI)
#   .env.defaults  this file                            (committed, AI-editable)
#
# There is deliberately no `.env.defaults.example`. This file *is* the reference.
# =============================================================================


# -----------------------------------------------------------------------------
# Dataset
# -----------------------------------------------------------------------------
# The PostgreSQL schema this dataset's tables live in, and the only identifier
# this dataset has.
#
# The namespace is a schema, not a table-name prefix. An earlier revision
# prefixed every table (`smbll_loan`) and it failed the one test that matters:
# the table name the agent saw depended on which engine was behind it, bare
# locally against SQLite and prefixed remotely, so every SQL example in the
# system prompt was correct in one environment and wrong in the other. A schema
# moves the namespace off the table name, so `loan` is `loan` everywhere and one
# prompt is honest in both places.
#
# Other projects share this Neon instance and live in other schemas. Nothing
# here ever names them, which is the entire point. `agent_app/quota.py` also
# partitions monthly LLM spend by this value.
#
# Must be a valid PostgreSQL identifier: lowercase letters, digits and
# underscores, not starting with a digit, at most 63 characters. `Config`
# enforces that at start-up, so a bad value fails immediately rather than deep
# inside a query.
#
# Override it in `.env` to point one checkout at a staging schema.
SCHEMA_NAME="govtech_saas_service_request_intelligence_large"


# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
# Exactly ONE provider is active per process. The matching credential is a
# secret and lives in `.env`.
#
# Valid values: bedrock | anthropic | openai | google
#
# anthropic, because on the golden set (`agent-app grade`) Claude Sonnet as
# the agent scored 97% SQL and answer accuracy where Nova Lite on Bedrock
# scored 61%: Nova answered follow-ups from the earlier turn without querying.
# Needs ANTHROPIC_API_KEY in `.env`. The same model runs on Bedrock: that
# switch is LLM_PROVIDER="bedrock" with
# LLM_MODEL_ID="global.anthropic.claude-sonnet-5-5", once the AWS account has
# been granted Anthropic model access.
LLM_PROVIDER="anthropic"
LLM_MODEL_ID="claude-sonnet-5-5"

# Optional. Overrides the provider's default model. Model ID formats are
# provider specific and NOT interchangeable -- if you switch LLM_PROVIDER,
# either update this too or leave it commented out to fall back to the default.
#
# The defaults below are a snapshot and WILL go stale: vendors release, rename,
# and retire models on their own schedules. If you hit an "unknown model" error,
# check the provider's current model list first.
#
#   bedrock   -> us.amazon.nova-lite-v1:0
#   anthropic -> claude-haiku-4-5-20251001
#   openai    -> gpt-5.6-luna
#   google    -> gemini-3.5-flash-lite
#
#LLM_MODEL_ID="gpt-5.6-luna"

# The provider and model the warehouse tool writes SQL with, behind the agent.
# Raised on its own on purpose: every number the agent reports comes out of
# this model's query, while the agent only routes and formats. Measured on the
# 12 kickstarts, Nova Lite as the writer got 7 to 9 of 11 numeric answers right.
#
# Comment both out to write SQL with the agent's own provider and model. The
# anthropic provider needs ANTHROPIC_API_KEY in `.env`. On Bedrock the same model
# is "global.anthropic.claude-sonnet-5-5" with SQL_WRITER_PROVIDER="bedrock",
# once the account has been granted Anthropic model access.
SQL_WRITER_PROVIDER="anthropic"
SQL_WRITER_MODEL_ID="claude-sonnet-5-5"

# 0 makes the same question produce the same SQL. "none" sends no temperature,
# which a model with thinking on (Sonnet by default) requires.
SQL_WRITER_TEMPERATURE="none"

# How hard each model thinks (anthropic only; low | medium | high | xhigh |
# max, unset is the model's default, high). Measured on the golden set on
# Snowflake, with prompt caching on:
#
#   agent high, writer high   p50 11.4s  p95 17.3s  answers 97%  (no caching)
#   agent low,  writer high   p50 10.5s  p95 15.4s  answers 100%
#   agent low,  writer medium p50  9.6s  p95 13.4s  answers 100%
#
# The agent only routes and words the answer, so low costs it nothing; the
# writer's SQL is every number, so it stays at medium.
LLM_EFFORT="low"
SQL_WRITER_EFFORT="medium"

# Where the agent's data tools are served. Leave it commented out locally: the
# agent then starts the MCP server itself as a child process. Set it to a
# streamable-HTTP endpoint (`agent-app mcp-server --transport streamable-http`)
# to run the tools as their own service.
#MCP_SERVER_URL="http://127.0.0.1:8100/mcp"

# -----------------------------------------------------------------------------
# Warehouse
# -----------------------------------------------------------------------------
# Where the agent's queries run: postgres (Neon, the DB_* settings in .env) or
# snowflake (below). The SQL writer writes PostgreSQL either way; the guard
# transpiles it to Snowflake SQL. Loaded by infra/snowflake/load.py.
#
# Snowflake is the production warehouse. Checked before switching: all 30
# golden references and all 13 semantic-layer metrics return the same answer
# on both. Set "postgres" to go back to Neon (e.g. when the trial ends): no
# other change needed.
WAREHOUSE="snowflake"

# Not secrets: an account identifier and object names. The private key is the
# secret -- a file on this machine (made by infra/snowflake/bootstrap.py), and
# SNOWFLAKE_PRIVATE_KEY in Secrets Manager for the deployed runtimes.
SNOWFLAKE_ACCOUNT="GOUXAKT-DDC71098"
SNOWFLAKE_USER="CITYPULSE_RO_SVC"
SNOWFLAKE_ROLE="CITYPULSE_RO"
SNOWFLAKE_WAREHOUSE="CITYPULSE_WH"
SNOWFLAKE_DATABASE="CITYPULSE_311"
SNOWFLAKE_SCHEMA="ANALYTICS"
SNOWFLAKE_PRIVATE_KEY_PATH="~/.snowflake/citypulse/ro_rsa_key.p8"

# Per-user tenant scope. CITYPULSE_RO sees every tenant; the row access policy
# scopes by the session's role, so a user who may see one tenant must have
# their queries run as a role the policy maps to it (CITYPULSE_AUDIT.
# TENANT_ROLE_ACCESS, filled by infra/snowflake/load.py). Both empty: every
# signed-in user is internal and runs as SNOWFLAKE_ROLE. With a map, a login
# it does not name gets TENANT_DEFAULT_ROLE, and with no default is refused.
#   TENANT_ROLE_MAP="octocat=CITYPULSE_TENANT_DEMO,alice=CITYPULSE_RO"
#   TENANT_DEFAULT_ROLE="CITYPULSE_TENANT_DEMO"
# TENANT_ROLE_TABLE names a warehouse table of (login, role_name) rows read as
# the map and refreshed every five minutes, with TENANT_ROLE_MAP laid over it:
# a customer's user is one INSERT, not a redeploy. The loader creates it
# (`load.py --step users`).
#   TENANT_ROLE_TABLE="CITYPULSE_AUDIT.USER_ROLE_ACCESS"
# Writes (the query log, feedback) always run as SNOWFLAKE_ROLE.
TENANT_ROLE_MAP=""
TENANT_DEFAULT_ROLE=""
TENANT_ROLE_TABLE=""

# The operator's switches: a kill switch that makes the warehouse tool answer
# "temporarily unavailable", and per-metric suspensions that refuse questions
# about one metric while the rest keep working. Read from this table every 30
# seconds, so `agent-app switch kill --on --reason "..."` takes effect without
# a deployment. The loader creates it (`load.py --step switches`). Empty: no
# switches.
SWITCH_TABLE="CITYPULSE_AUDIT.SWITCHES"

# Answer a plain metric question ("SLA breach rate by size tier over the last
# 12 months") from the semantic layer's compiler, skipping the SQL writer's
# round trip. A question that says anything the layer has no word for goes to
# the writer regardless. On since the eval of 2026-10-10 (data/eval/results.md):
# six of six plain questions right, 4.2s median against the writer's 8.5s,
# everything else untouched.
FAST_PATH="true"

# Region for every AWS service. Not a secret; the credentials that go with it
# are, and they live in `.env` (or in ~/.aws/credentials locally).
AWS_REGION="us-east-1"


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Only the port. Host, user, password and database name identify a real
# instance, so they are secrets and live in `.env`.
DB_PORT="5432"


# -----------------------------------------------------------------------------
# Monthly LLM spend cap -- OFF by default
# -----------------------------------------------------------------------------
# Only for a public deployment where the person paying is not the person typing.
# Leave it off for local development: you are spending your own allowance and a
# cap would just get in the way.
QUOTA_ENABLED="false"
QUOTA_MAX_INVOKE_PER_MONTH="1000"
QUOTA_MAX_INPUT_TOKEN_PER_MONTH="50000000"
QUOTA_MAX_OUTPUT_TOKEN_PER_MONTH="10000000"

# The DynamoDB table holding the counters. No default is possible -- it has to
# be a table you created. Its partition key must be `app_id` (type String);
# nothing else about it matters. Row keys look like
# `311-analytics-agent:<SCHEMA_NAME>:YYYY-MM`, so one table can hold the
# counters for many deployments.
#
# A table name is not a credential: without IAM permissions it grants nothing,
# and unlike DB_HOST there is no endpoint behind it to reach. It lives here
# rather than in `.env` so that turning the quota on is one file, not two. If
# you would rather not commit your table's name, set it in `.env` instead --
# `.env` is read first, so it wins either way.
#DYNAMODB_TABLE_NAME_QUOTA="my-llm-quota"
